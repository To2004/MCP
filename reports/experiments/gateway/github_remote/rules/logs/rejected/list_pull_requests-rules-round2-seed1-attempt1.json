{
 "tool_name": "list_pull_requests",
 "arguments": [
  {
   "path": "type[]",
   "classification": "CONTENT",
   "rule": {
    "kind": "keywords",
    "groups": [
     {
      "contains": [
       "body",
       "comments"
      ],
      "level": 4
     },
     {
      "contains": [
       "title",
       "state",
       "author_association"
      ],
      "level": 2
     }
    ],
    "default": 3
   },
   "when_absent": null,
   "source": "inferred",
   "reason": "Reducing response size by excluding sensitive fields",
   "confidence": 0.0
  },
  {
   "path": "perPage",
   "classification": "RANGE",
   "rule": {
    "kind": "ranges",
    "measure": "value",
    "ranges": [
     {
      "min": null,
      "max": 10,
      "level": 2
     },
     {
      "min": 10,
      "max": 50,
      "level": 3
     },
     {
      "min": 50,
      "max": 100,
      "level": 4
     }
    ],
    "default": 3
   },
   "when_absent": null,
   "source": "schema",
   "reason": "Larger page sizes move more data in a single call",
   "confidence": 0.0
  }
 ]
}