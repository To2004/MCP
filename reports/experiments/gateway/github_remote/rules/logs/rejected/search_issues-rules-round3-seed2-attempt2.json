{
 "tool_name": "search_issues",
 "arguments": [
  {
   "path": "type",
   "classification": "CONTENT",
   "rule": {
    "kind": "keywords",
    "groups": [
     {
      "contains": [
       "body",
       "reactions",
       "labels"
      ],
      "level": 4
     },
     {
      "contains": [
       "title"
      ],
      "level": 2
     }
    ],
    "default": 3
   },
   "when_absent": null,
   "source": "inferred",
   "reason": "Sensitive fields like 'body' increase risk.",
   "confidence": 0.8
  },
  {
   "path": "perPage",
   "classification": "RANGE",
   "rule": {
    "kind": "ranges",
    "measure": "value",
    "ranges": [
     {
      "min": null,
      "max": 10,
      "level": 2
     },
     {
      "min": 10,
      "max": 50,
      "level": 3
     },
     {
      "min": 50,
      "max": 100,
      "level": 4
     }
    ],
    "default": 3
   },
   "when_absent": null,
   "source": "schema",
   "reason": "Returning fewer results is safer.",
   "confidence": 0.8
  }
 ]
}