{
 "tool_name": "search_issues",
 "arguments": [
  {
   "path": "type",
   "classification": "MODE",
   "rule": {
    "kind": "values",
    "values": [
     {
      "value": "title",
      "level": 2
     },
     {
      "value": "body",
      "level": 4
     }
    ],
    "default": 3
   },
   "when_absent": null,
   "source": "inferred",
   "reason": "Reducing fields to 'title' is safer than including sensitive 'body'",
   "confidence": 0.0
  },
  {
   "path": "perPage",
   "classification": "RANGE",
   "rule": {
    "kind": "ranges",
    "measure": "value",
    "ranges": [
     {
      "min": null,
      "max": 10,
      "level": 2
     },
     {
      "min": 10,
      "max": 50,
      "level": 3
     },
     {
      "min": 50,
      "max": 90,
      "level": 4
     },
     {
      "min": 90,
      "max": null,
      "level": 5
     }
    ],
    "default": 3
   },
   "when_absent": null,
   "source": "schema",
   "reason": "Returning a large number of results per page is riskier",
   "confidence": 0.0
  }
 ]
}