{
 "tool_name": "search_issues",
 "arguments": [
  {
   "path": "type[]",
   "classification": "MODE",
   "rule": {
    "kind": "keywords",
    "groups": [
     {
      "contains": [
       "body"
      ],
      "level": 5
     },
     {
      "contains": [
       "reactions",
       "labels"
      ],
      "level": 4
     }
    ],
    "default": 2
   },
   "when_absent": null,
   "source": "inferred",
   "reason": "Including sensitive fields increases risk.",
   "confidence": 0.8
  },
  {
   "path": "perPage",
   "classification": "RANGE",
   "rule": {
    "kind": "ranges",
    "measure": "value",
    "ranges": [
     {
      "min": null,
      "max": 10,
      "level": 2
     },
     {
      "min": 10,
      "max": 50,
      "level": 3
     },
     {
      "min": 50,
      "max": 100,
      "level": 4
     }
    ],
    "default": 3
   },
   "when_absent": null,
   "source": "schema",
   "reason": "Larger page sizes move more data.",
   "confidence": 0.7
  }
 ]
}