  "baselines": {
    "scheduler_bot": {
      "app_id": "scheduler_bot",
      "reasoning": "The scheduler_bot is designed to book and reschedule team meetings, which involves creating, updating, and potentially deleting events within the calendar system. Given its purpose, it should not hold PII at scale or send external messages under user identity, as these actions are considered dangerous in this domain.",
      "expected_tools": [
        "create-event",
        "update-event",
        "delete-event"
      ],
      "expected_flows": [
        {
          "pattern": "create-event for team meetings",
          "normal_sensitivity_max": 3
        },
        {
          "pattern": "update-event to reschedule existing meetings",
          "normal_sensitivity_max": 4
        },
        {
          "pattern": "delete-event if meeting is canceled and recovery is possible",
          "normal_sensitivity_max": 5
        }
      ],
      "anomalous_patterns": [
        "holds PII at scale",
        "can send external messages under user identity"
      ],
      "confidence": 0.9
    },
    "exec_assistant": {
      "app_id": "exec_assistant",
      "reasoning": "The application is designed to manage the executive calendar and invites, which involves creating, updating, deleting events, managing attendee lists, and sending invitations. Given its purpose, it should not hold PII at scale or execute arbitrary code under user identity.",
      "expected_tools": [
        "create-event",
        "update-event",
        "delete-event",
        "manage-attendee-lists",
        "send-invites"
      ],
      "expected_flows": [
        {
          "pattern": "create-event with conflict detection",
          "normal_sensitivity_max": 3
        },
        {
          "pattern": "update-event on executive calendar",
          "normal_sensitivity_max": 4
        },
        {
          "pattern": "delete-event if recoverable",
          "normal_sensitivity_max": 2
        },
        {
          "pattern": "manage-attendee-lists for events",
          "normal_sensitivity_max": 3
        },
        {
          "pattern": "send-invites to attendees",
          "normal_sensitivity_max": 3
        }
      ],
      "anomalous_patterns": [
        "create-events with no conflict detection",
        "delete-event (if not recoverable)",
        "respond-to-event (changes RSVP state) without user consent"
      ],
      "confidence": 0.9
    }
  },
