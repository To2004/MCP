{
 "tool_name": "create_pull_request",
 "arguments": [
  {
   "path": "owner.repo",
   "kind": "asset_id",
   "rankable": true,
   "safest": "helios-public-site, 2",
   "riskiest": "helios-scada-gateway, 5",
   "reason": "The repository can be a public site or a BES cyber system."
  },
  {
   "path": "title",
   "kind": "content",
   "rankable": true,
   "safest": "routine update, 2",
   "riskiest": "confidential bidding strategy change, 5",
   "reason": "The title can reveal the nature of changes."
  },
  {
   "path": "body",
   "kind": "content",
   "rankable": true,
   "safest": "routine update details, 2",
   "riskiest": "confidential bidding strategy parameters, 5",
   "reason": "The body can contain sensitive information."
  },
  {
   "path": "head",
   "kind": "name_or_path",
   "rankable": true,
   "safest": "routine update branch, 2",
   "riskiest": "confidential bidding strategy branch, 5",
   "reason": "The head can point to sensitive branches."
  },
  {
   "path": "base",
   "kind": "name_or_path",
   "rankable": true,
   "safest": "main branch, 2",
   "riskiest": "confidential bidding strategy main branch, 5",
   "reason": "The base can point to sensitive branches."
  },
  {
   "path": "draft",
   "kind": "choice",
   "rankable": true,
   "safest": "false, 2",
   "riskiest": "true, 4",
   "reason": "A draft pull request is more sensitive as it may contain unfinished work."
  },
  {
   "path": "maintainer_can_modify",
   "kind": "choice",
   "rankable": true,
   "safest": "false, 2",
   "riskiest": "true, 4",
   "reason": "Allowing maintainers to modify can expose the pull request to more risk."
  }
 ]
}