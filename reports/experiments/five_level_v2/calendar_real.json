  "baselines": {
    "scheduler_bot": {
      "app_id": "scheduler_bot",
      "reasoning": "The scheduler_bot is designed to book and reschedule team meetings, which involves creating, updating, and deleting events in a calendar system. Given the domain profile, these actions should be confined to non-critical calendars and should not involve PII at scale or shared calendars without proper permissions.",
      "expected_tools": [
        "create-event",
        "update-event",
        "delete-event"
      ],
      "expected_flows": [
        {
          "pattern": "create-event for team meetings",
          "normal_sensitivity_max": 2
        },
        {
          "pattern": "update-event to reschedule team meetings",
          "normal_sensitivity_max": 3
        },
        {
          "pattern": "delete-event when a meeting is canceled",
          "normal_sensitivity_max": 4
        }
      ],
      "anomalous_patterns": [
        "create-events in bulk without conflict detection on critical calendars",
        "delete-event when applied to critical calendars (e.g., executive or recruiting) without backups"
      ],
      "confidence": 0.9
    },
    "exec_assistant": {
      "app_id": "exec_assistant",
      "reasoning": "The executive assistant application is expected to manage the calendar of an executive, which includes scheduling events, sending invites, and managing event details. Given its purpose, it should not engage in actions that could lead to irreversible data loss or unauthorized access to PII at scale.",
      "expected_tools": [
        "create-event",
        "update-event",
        "delete-event-with-backup",
        "send-invite"
      ],
      "expected_flows": [
        {
          "pattern": "create-event with executive calendar as target",
          "normal_sensitivity_max": 3
        },
        {
          "pattern": "update-event for existing events in the executive calendar",
          "normal_sensitivity_max": 2
        },
        {
          "pattern": "delete-event-with-backup when event is no longer needed",
          "normal_sensitivity_max": 4
        },
        {
          "pattern": "send-invite to attendees with appropriate permissions",
          "normal_sensitivity_max": 3
        }
      ],
      "anomalous_patterns": [
        "create-events in bulk without conflict detection on the executive calendar",
        "delete-event without backup for critical events"
      ],
      "confidence": 0.95
    }
