[
  {
    "name": "set",
    "description": "Sets a key-value pair in Redis with an optional expiration.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {"type": "string"},
        "value": {"type": "string"},
        "expireSeconds": {"type": "number"}
      },
      "required": ["key", "value"]
    }
  },
  {
    "name": "get",
    "description": "Gets the value associated with a key.",
    "inputSchema": {
      "type": "object",
      "properties": {"key": {"type": "string"}},
      "required": ["key"]
    }
  },
  {
    "name": "delete",
    "description": "Deletes one or more keys from Redis.",
    "inputSchema": {
      "type": "object",
      "properties": {"key": {"oneOf": [{"type": "string"}, {"type": "array"}]}},
      "required": ["key"]
    }
  },
  {
    "name": "list",
    "description": "Lists Redis keys matching a glob pattern.",
    "inputSchema": {
      "type": "object",
      "properties": {"pattern": {"type": "string"}}
    }
  }
]
